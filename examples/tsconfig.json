{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@expressive/dom",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "paths": { "@expressive/three": ["../src/index.ts"] }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
