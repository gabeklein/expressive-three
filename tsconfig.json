{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src", "test.setup.ts"]
}
