{
  "name": "expressive-three",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter='./packages/*' build",
    "typecheck": "bun run --filter='./packages/*' typecheck",
    "coverage": "bun run --filter='./packages/*' coverage",
    "test": "bun run --filter='./packages/*' test",
    "probe": "bun .github/scripts/three-probe.ts",
    "changeset": "changeset",
    "ci:version": "changeset version && bun install",
    "ci:publish": "bun run --filter='./packages/*' build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.27.12",
    "@types/node": "^25.2.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "three": "^0.185.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
